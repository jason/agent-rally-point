{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rally-point:schema:envelope.v1",
  "title": "Agent Rally Point canonical event envelope v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "specversion",
    "id",
    "source",
    "subject",
    "time",
    "kind",
    "type",
    "tool",
    "model",
    "run_id",
    "app_slug",
    "thread_id",
    "causation_id",
    "correlation_id",
    "datacontenttype",
    "dataschema",
    "payload",
    "revision"
  ],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^evt_[0-9a-f]{32}$" },
    "source": { "type": "string", "pattern": "^urn:agent-rally-point:tool:" },
    "subject": { "type": "string" },
    "time": { "type": "string", "format": "date-time", "description": "RFC3339 UTC event time for protocol consumers." },
    "kind": { "type": "string" },
    "type": { "type": "string", "pattern": "^agent-rally\\." },
    "tool": { "type": "string" },
    "model": { "type": "string" },
    "run_id": { "type": "string" },
    "app_slug": { "type": "string" },
    "thread_id": { "type": "string", "pattern": "^thr_[0-9a-f]{32}$" },
    "causation_id": { "type": ["string", "null"], "pattern": "^evt_[0-9a-f]{32}$" },
    "correlation_id": { "type": "string" },
    "datacontenttype": { "const": "application/json" },
    "dataschema": { "type": "string" },
    "payload": { "type": "object" },
    "revision": { "type": "integer", "minimum": 0 }
  }
}
